# 配置 npm 行为
legacy-peer-deps=true
strict-ssl=false
registry=https://registry.npmjs.org/

# Windows 下强制安装可选依赖
# optional=true
# include=optional

# 配置 Rollup 相关
rollup-ignore-optional-deps=false

# 网络配置
fetch-retries=3
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000
# 1. 安全起见，全局允许所有不信任的安装脚本
ignore-scripts=false

# 2. 显式指定：只允许下列依赖运行它们的构建脚本
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=bcrypt
onlyBuiltDependencies[]=@scarf/scarf
onlyBuiltDependencies[]=core-js-pure
onlyBuiltDependencies[]=core-js
onlyBuiltDependencies[]=@tree-sitter-grammars/tree-sitter-yaml
onlyBuiltDependencies[]=tree-sitter-json
onlyBuiltDependencies[]=tree-sitter