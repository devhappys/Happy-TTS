{
  "name": "synapse",
  "version": "1.0.0",
  "description": "Synapse with Node.js",
  "main": "dist/app.js",
  "sideEffects": true,
  "scripts": {
    "start": "node dist/app.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --watch src -e ts --exec ts-node src/app.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:simple": "pnpm run build:backend && pnpm run build:frontend:simple",
    "build:minimal": "pnpm run build:backend && pnpm run build:frontend:minimal",
    "build:backend": "tsc && node scripts/copy-templates.js && pnpm run obfuscate",
    "build:backend:clean": "rm -rf dist && tsc && pnpm run obfuscate",
    "obfuscate": "javascript-obfuscator dist --output dist-obfuscated --config package.json",
    "build:frontend": "cd frontend && pnpm install --frozen-lockfile --ignore-scripts && pnpm run build",
    "build:frontend:simple": "cd frontend && pnpm run build:simple",
    "build:frontend:minimal": "cd frontend && pnpm run build:minimal",
    "prod": "pnpm run build && pnpm start",
    "test": "jest --forceExit --detectOpenHandles",
    "test:simple": "jest --forceExit --detectOpenHandles --testPathPatterns=\"smartHumanCheckService|nonceStore|domainExemption\" --testNamePattern=\"should\" --verbose",
    "test:fix": "jest --forceExit --detectOpenHandles --testPathPatterns=\"smartHumanCheckService\\.test\\.ts|nonceStore\\.test\\.ts|domainExemption\\.test\\.ts\" --testNamePattern=\"should\" --verbose --maxWorkers=1",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "test:verbose": "jest --verbose --forceExit --detectOpenHandles",
    "test:clean": "node scripts/test-cleanup.js",
    "test:auth": "jest --testPathPattern=authController.test.ts",
    "test:rate-limit": "jest --testPathPattern=rateLimit.test.ts",
    "test:db-init": "node scripts/test-database-init.js",
    "test:performance": "jest performance.test.ts",
    "test:concurrency": "jest concurrency.test.ts",
    "test:ci": "jest --ci --runInBand --coverage --reporters=default --reporters=jest-junit",
    "generate:openapi": "node scripts/generate-openapi.js",
    "generate:route-audit": "ts-node --transpile-only scripts/generate-route-audit.ts",
    "migrate:tts-user-datas": "node scripts/migrations/migrate-tts-user-datas.js",
    "migrate:user-passwords": "ts-node --transpile-only scripts/migrations/migrate-user-passwords.ts",
    "check:api-docs": "node scripts/check-api-docs.js",
    "check:openapi-json": "node scripts/check-openapi-json.js",
    "analyze:bundle": "pnpm run build:backend && pnpm run analyze:size",
    "analyze:size": "node -e \"const fs=require('fs');const path=require('path');const dir='dist';const files=fs.readdirSync(dir).filter(f=>f.endsWith('.js'));let total=0;files.forEach(f=>{const size=fs.statSync(path.join(dir,f)).size;total+=size;console.log(f+' '+Math.round(size/1024)+'KB')});console.log('Total: '+Math.round(total/1024)+'KB')\"",
    "analyze:full": "node scripts/analyze-bundle.js",
    "analyze:frontend": "cd frontend && pnpm run build:analyze",
    "analyze:backend": "pnpm run build:backend && pnpm run analyze:size",
    "profile:start": "node scripts/run-node-with-profiling.js",
    "profile:cpu": "node scripts/run-node-with-profiling.js --cpu",
    "profile:heap": "node scripts/run-node-with-profiling.js --heap",
    "profile:inspect": "node scripts/run-node-with-profiling.js --inspect",
    "profile:load": "node scripts/run-load-profile-report.js",
    "benchmark:rust": "node scripts/run-rust-worker-benchmark.js",
    "check:unused-deps": "npx depcheck",
    "check:tree-shaking": "pnpm run analyze:full && echo '检查完成，请查看上面的分析结果'",
    "check:tree-shaking-config": "node scripts/check-tree-shaking.js",
    "docker:build": "scripts/build-docker.sh",
    "docker:build:win": "scripts\\build-docker.bat",
    "docker:build:simple": "docker build --platform linux/amd64 --memory=4g --memory-swap=4g -t synapse:simple .",
    "docker:build:minimal": "docker build --platform linux/amd64 --memory=2g --memory-swap=2g -t synapse:minimal ."
  },
  "keywords": [
    "happy",
    "tts"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cathodique/mmap-io": "^1.5.5",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/express-rate-limit": "^6.0.2",
    "@types/form-data": "^2.5.2",
    "@types/jsdom": "^28.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^11.0.0",
    "@types/validator": "^13.15.10",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.8",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "http-proxy-agent": "^9.1.0",
    "is-docker": "^4.0.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "liquid-glass-react": "^1.1.1",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.1",
    "marked": "^18.0.5",
    "mongodb": "^7.2.0",
    "mongodb-connection-string-url": "^7.0.1",
    "mongoose": "^9.6.3",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.5",
    "nanoid": "^5.1.11",
    "openai": "^6.42.0",
    "path-to-regexp": "^8.4.2",
    "qrcode": "^1.5.4",
    "react-syntax-highlighter": "^16.1.1",
    "redis": "^6.0.0",
    "resend": "^6.12.4",
    "serve": "^14.2.6",
    "socks-proxy-agent": "^10.0.0",
    "speakeasy": "^2.0.0",
    "svix": "^1.95.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "synapse": "file:",
    "tar": "^7.5.16",
    "tar-fs": "^3.1.2",
    "uuid": "^14.0.0",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "fast-check": "^4.8.0",
    "javascript-obfuscator": "^5.4.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.2",
      "ajv": ">=8.18.0",
      "diff": ">=4.0.4",
      "minimatch": ">=10.2.1"
    },
    "onlyBuiltDependencies": [
      "@cathodique/mmap-io",
      "@scarf/scarf",
      "bcrypt",
      "unrs-resolver"
    ]
  }
}
