{
  "version": 2,
  "installCommand": "cd frontend && pnpm install --frozen-lockfile --prefer-offline --ignore-scripts",
  "buildCommand": "cd frontend && pnpm run build:vercel",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
